{
  "entities": {
    "AizerTechUser": {
      "title": "AizerTechUser",
      "description": "Registered Google-authenticated user saved in aizertech_users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 150 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "phonePrompted": { "type": "boolean" },
        "firstLoginAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "totalRequests": { "type": "number", "minimum": 0, "maximum": 100000 }
      },
      "required": ["uid", "name", "email", "photoUrl", "phone", "phonePrompted", "firstLoginAt", "lastActiveAt", "totalRequests"]
    },
    "AizerTechVisit": {
      "title": "AizerTechVisit",
      "description": "Unique daily website visit recorded in aizertech_visits (admin visits excluded).",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "timeLabel": { "type": "string", "minLength": 2, "maxLength": 20 },
        "pageVisited": { "type": "string", "minLength": 2, "maxLength": 60 },
        "device": { "type": "string", "enum": ["Mobile", "Desktop"] },
        "country": { "type": "string", "minLength": 0, "maxLength": 80 },
        "visitorKey": { "type": "string", "minLength": 4, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dateKey", "timeLabel", "pageVisited", "device", "country", "visitorKey", "createdAt"]
    },
    "AizerTechChatThread": {
      "title": "AizerTechChatThread",
      "description": "Real-time live chat thread metadata between an authenticated client and AizerTech.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "userEmail": { "type": "string", "format": "email", "minLength": 5, "maxLength": 150 },
        "userPhoto": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "userPhone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "lastMessage": { "type": "string", "minLength": 0, "maxLength": 500 },
        "lastSenderRole": { "type": "string", "enum": ["client", "admin"] },
        "unreadByAdmin": { "type": "number", "minimum": 0, "maximum": 1000 },
        "unreadByClient": { "type": "number", "minimum": 0, "maximum": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "userEmail", "userPhoto", "userPhone", "lastMessage", "lastSenderRole", "unreadByAdmin", "unreadByClient", "createdAt", "updatedAt"]
    },
    "AizerTechChatMessage": {
      "title": "AizerTechChatMessage",
      "description": "Individual live chat message inside /aizertech_chats/{userId}/messages.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "senderRole": { "type": "string", "enum": ["client", "admin"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "senderRole", "text", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Legacy contact inquiry record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "senderEmail": { "type": "string", "format": "email", "minLength": 5, "maxLength": 150 },
        "senderPhone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "serviceType": { "type": "string", "minLength": 2, "maxLength": 100 },
        "budgetTier": { "type": "string", "minLength": 1, "maxLength": 60 },
        "message": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "status": {
          "type": "string",
          "enum": ["new", "talking", "quoted", "paid", "done", "lost", "reviewed", "replied", "archived"]
        },
        "adminNote": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderName", "senderEmail", "senderPhone", "serviceType", "budgetTier", "message", "status", "createdAt", "updatedAt"]
    },
    "AizerTechMessage": {
      "title": "AizerTechMessage",
      "description": "Authenticated client project inquiry stored in aizertech_messages.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 150 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "service": { "type": "string", "minLength": 2, "maxLength": 100 },
        "budget": { "type": "string", "minLength": 1, "maxLength": 60 },
        "message": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "status": {
          "type": "string",
          "enum": ["new", "talking", "quoted", "paid", "done", "lost", "reviewed", "replied", "archived"]
        },
        "adminNote": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "service", "budget", "message", "status", "createdAt", "updatedAt"]
    },
    "AizerTechInvoice": {
      "title": "AizerTechInvoice",
      "description": "Client invoice generated from Admin with GHS amount, MoMo instructions, and paid/unpaid status.",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "minLength": 2, "maxLength": 30 },
        "clientName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "clientPhone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "clientEmail": { "type": "string", "minLength": 0, "maxLength": 150 },
        "service": { "type": "string", "minLength": 2, "maxLength": 120 },
        "amountGhs": { "type": "number", "minimum": 0, "maximum": 10000000 },
        "description": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "invoiceDate": { "type": "string", "minLength": 4, "maxLength": 30 },
        "status": { "type": "string", "enum": ["unpaid", "paid"] },
        "sourceMessageId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invoiceNumber", "clientName", "clientPhone", "clientEmail", "service", "amountGhs", "description", "invoiceDate", "status", "sourceMessageId", "createdAt", "updatedAt"]
    },
    "AizerTechBooking": {
      "title": "AizerTechBooking",
      "description": "Free consultation call booking submitted by Google-authenticated users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "clientPhone": { "type": "string", "minLength": 7, "maxLength": 30 },
        "preferredDate": { "type": "string", "minLength": 6, "maxLength": 20 },
        "preferredTime": { "type": "string", "minLength": 3, "maxLength": 30 },
        "service": { "type": "string", "minLength": 2, "maxLength": 120 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "done", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "clientPhone", "preferredDate", "preferredTime", "service", "status", "createdAt", "updatedAt"]
    },
    "AizerTechTestimonial": {
      "title": "AizerTechTestimonial",
      "description": "Client testimonial managed by Admin and displayed live when approved.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "service": { "type": "string", "minLength": 2, "maxLength": 120 },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "message": { "type": "string", "minLength": 5, "maxLength": 1200 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 500000 },
        "approved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "service", "rating", "message", "photoUrl", "approved", "createdAt", "updatedAt"]
    },
    "StudioProject": {
      "title": "StudioProject",
      "description": "Tracked Aizer Tech client project managed in the CEO console for delivery and revenue computation.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "clientName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "clientPhone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "serviceType": { "type": "string", "minLength": 2, "maxLength": 80 },
        "amountGhs": { "type": "number", "minimum": 0, "maximum": 10000000 },
        "status": { "type": "string", "enum": ["in_progress", "done"] },
        "notes": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "clientName", "clientPhone", "serviceType", "amountGhs", "status", "notes", "createdAt", "updatedAt"]
    },
    "WebsiteCmsDocument": {
      "title": "WebsiteCmsDocument",
      "description": "Full Website Control Center CMS state stored in aizertech_draft/website and aizertech_live/website.",
      "type": "object",
      "properties": {
        "hero": { "type": "object" },
        "services": { "type": "array" },
        "projects": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hero", "services", "projects", "updatedAt"]
    },
    "WebsiteBackup": {
      "title": "WebsiteBackup",
      "description": "Automatic snapshot stored in aizertech_backup before publishing a new live website version.",
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 2, "maxLength": 120 },
        "snapshot": { "type": "object" },
        "backedUpAt": { "type": "string", "format": "date-time" }
      },
      "required": ["label", "snapshot", "backedUpAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized studio administrator record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["email", "role"]
    },
    "StudioSettings": {
      "title": "StudioSettings",
      "description": "Synced studio settings including MoMo payment details, auto-reply template, and working hours.",
      "type": "object",
      "properties": {
        "heroHeadline": { "type": "string", "minLength": 10, "maxLength": 140 },
        "heroSubheadline": { "type": "string", "minLength": 10, "maxLength": 350 },
        "announcementBanner": { "type": "string", "minLength": 0, "maxLength": 160 },
        "websiteStartingPrice": { "type": "string", "minLength": 2, "maxLength": 40 },
        "mobileStartingPrice": { "type": "string", "minLength": 2, "maxLength": 40 },
        "brandingStartingPrice": { "type": "string", "minLength": 2, "maxLength": 40 },
        "whatsappNumber": { "type": "string", "minLength": 7, "maxLength": 20 },
        "contactEmail": { "type": "string", "format": "email", "minLength": 5, "maxLength": 150 },
        "founderBio": { "type": "string", "minLength": 20, "maxLength": 600 },
        "momoNumber": { "type": "string", "minLength": 0, "maxLength": 30 },
        "momoName": { "type": "string", "minLength": 0, "maxLength": 80 },
        "autoReplyMessage": { "type": "string", "minLength": 0, "maxLength": 500 },
        "workingHours": { "type": "string", "minLength": 0, "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["heroHeadline", "heroSubheadline", "announcementBanner", "websiteStartingPrice", "mobileStartingPrice", "brandingStartingPrice", "whatsappNumber", "contactEmail", "founderBio", "updatedAt"]
    }
  },
  "firestore": {
    "/aizertech_users/{userId}": { "schema": { "$ref": "#/entities/AizerTechUser" }, "description": "Registered Google-authenticated client accounts." },
    "/aizertech_visits/{visitId}": { "schema": { "$ref": "#/entities/AizerTechVisit" }, "description": "Unique daily visitor analytics records." },
    "/aizertech_chats/{chatUserId}": { "schema": { "$ref": "#/entities/AizerTechChatThread" }, "description": "Real-time live chat threads between clients and AizerTech." },
    "/aizertech_chats/{chatUserId}/messages/{chatMsgId}": { "schema": { "$ref": "#/entities/AizerTechChatMessage" }, "description": "Immutable live chat messages inside a user thread." },
    "/contactMessages/{messageId}": { "schema": { "$ref": "#/entities/ContactMessage" }, "description": "Legacy contact inquiries." },
    "/aizertech_messages/{messageId}": { "schema": { "$ref": "#/entities/AizerTechMessage" }, "description": "Authenticated AizerTech GH inquiries with pipeline stages & private CEO notes." },
    "/aizertech_invoices/{invoiceId}": { "schema": { "$ref": "#/entities/AizerTechInvoice" }, "description": "Client invoices readable by owning client email and managed by CEO." },
    "/aizertech_bookings/{bookingId}": { "schema": { "$ref": "#/entities/AizerTechBooking" }, "description": "Authenticated free call consultation bookings." },
    "/aizertech_testimonials/{testimonialId}": { "schema": { "$ref": "#/entities/AizerTechTestimonial" }, "description": "Client testimonials; approved items read live by visitors." },
    "/studioProjects/{projectId}": { "schema": { "$ref": "#/entities/StudioProject" }, "description": "Private CEO studio project ledger." },
    "/aizertech_live/{docId}": { "schema": { "$ref": "#/entities/WebsiteCmsDocument" }, "description": "Live public website CMS document." },
    "/aizertech_draft/{docId}": { "schema": { "$ref": "#/entities/WebsiteCmsDocument" }, "description": "Private admin-only draft website CMS document." },
    "/aizertech_backup/{backupId}": { "schema": { "$ref": "#/entities/WebsiteBackup" }, "description": "Private admin-only auto-backups saved prior to each publish." },
    "/admins/{adminId}": { "schema": { "$ref": "#/entities/AdminUser" }, "description": "Read-only admin authorization lookup documents." },
    "/studioSettings/{settingId}": { "schema": { "$ref": "#/entities/StudioSettings" }, "description": "Publicly readable studio settings including MoMo & auto-reply defaults." }
  }
}
