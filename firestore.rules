rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'sablahevans0@gmail.com' ||
        request.auth.token.email == 'sablaizer@gmail.com'
      );
    }

    function isValidEmail(email) {
      return email is string &&
        email.size() >= 5 &&
        email.size() <= 150 &&
        email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isValidMessageStatus(status) {
      return status is string && status in [
        'new',
        'talking',
        'quoted',
        'paid',
        'done',
        'lost',
        'reviewed',
        'replied',
        'archived'
      ];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'name',
          'email',
          'photoUrl',
          'phone',
          'phonePrompted',
          'firstLoginAt',
          'lastActiveAt',
          'totalRequests'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'photoUrl',
          'phone',
          'phonePrompted',
          'firstLoginAt',
          'lastActiveAt',
          'totalRequests'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidEmail(data.email) &&
        data.photoUrl is string && data.photoUrl.size() <= 1000 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.phonePrompted is bool &&
        data.firstLoginAt is timestamp &&
        data.lastActiveAt is timestamp &&
        data.totalRequests is number && data.totalRequests >= 0 && data.totalRequests <= 100000;
    }

    match /aizertech_users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isVerified() && request.auth.uid == userId));
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isVerified() &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().email == request.auth.token.email &&
        incoming().totalRequests == 0 &&
        incoming().firstLoginAt == request.time &&
        incoming().lastActiveAt == request.time;
      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().firstLoginAt == existing().firstLoginAt && (
          (
            isAdmin() &&
            incoming().lastActiveAt == request.time
          ) || (
            isVerified() &&
            request.auth.uid == userId &&
            incoming().email == existing().email &&
            incoming().lastActiveAt == request.time &&
            incoming().totalRequests >= existing().totalRequests &&
            incoming().totalRequests <= existing().totalRequests + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'photoUrl',
              'phone',
              'phonePrompted',
              'lastActiveAt',
              'totalRequests'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    function isValidVisit(data) {
      return data.keys().hasAll([
          'dateKey',
          'timeLabel',
          'pageVisited',
          'device',
          'country',
          'visitorKey',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'dateKey',
          'timeLabel',
          'pageVisited',
          'device',
          'country',
          'visitorKey',
          'createdAt'
        ]) &&
        data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.timeLabel is string && data.timeLabel.size() >= 2 && data.timeLabel.size() <= 20 &&
        data.pageVisited is string && data.pageVisited.size() >= 2 && data.pageVisited.size() <= 60 &&
        data.device is string && data.device in ['Mobile', 'Desktop'] &&
        data.country is string && data.country.size() <= 80 &&
        data.visitorKey is string && data.visitorKey.size() >= 4 && data.visitorKey.size() <= 80 &&
        data.createdAt is timestamp;
    }

    match /aizertech_visits/{visitId} {
      allow get: if isValidId(visitId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(visitId) &&
        isValidVisit(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(visitId) && isAdmin();
    }

    function isValidChatThread(data) {
      return data.keys().hasAll([
          'userId',
          'userName',
          'userEmail',
          'userPhoto',
          'userPhone',
          'lastMessage',
          'lastSenderRole',
          'unreadByAdmin',
          'unreadByClient',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'userName',
          'userEmail',
          'userPhoto',
          'userPhone',
          'lastMessage',
          'lastSenderRole',
          'unreadByAdmin',
          'unreadByClient',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        isValidEmail(data.userEmail) &&
        data.userPhoto is string && data.userPhoto.size() <= 1000 &&
        data.userPhone is string && data.userPhone.size() <= 30 &&
        data.lastMessage is string && data.lastMessage.size() <= 500 &&
        data.lastSenderRole is string && data.lastSenderRole in ['client', 'admin'] &&
        data.unreadByAdmin is number && data.unreadByAdmin >= 0 && data.unreadByAdmin <= 1000 &&
        data.unreadByClient is number && data.unreadByClient >= 0 && data.unreadByClient <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'senderId',
          'senderName',
          'senderRole',
          'text',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'senderId',
          'senderName',
          'senderRole',
          'text',
          'createdAt'
        ]) &&
        data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.senderRole is string && data.senderRole in ['client', 'admin'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
        data.createdAt is timestamp;
    }

    match /aizertech_chats/{chatUserId} {
      allow get: if isValidId(chatUserId) && (isAdmin() || (isVerified() && request.auth.uid == chatUserId));
      allow list: if isAdmin();
      allow create: if isValidId(chatUserId) &&
        isVerified() &&
        (isAdmin() || request.auth.uid == chatUserId) &&
        isValidChatThread(incoming()) &&
        incoming().userId == chatUserId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(chatUserId) &&
        isVerified() &&
        isValidChatThread(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            request.auth.uid == chatUserId && (
              (
                incoming().lastSenderRole == 'client' &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'userName',
                  'userEmail',
                  'userPhoto',
                  'userPhone',
                  'lastMessage',
                  'lastSenderRole',
                  'unreadByAdmin',
                  'unreadByClient',
                  'updatedAt'
                ])
              ) || (
                incoming().unreadByClient == 0 &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'unreadByClient',
                  'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isValidId(chatUserId) && isAdmin();

      match /messages/{chatMsgId} {
        allow get: if isValidId(chatUserId) && isValidId(chatMsgId) && (isAdmin() || (isVerified() && request.auth.uid == chatUserId));
        allow list: if isValidId(chatUserId) && (isAdmin() || (isVerified() && request.auth.uid == chatUserId));
        allow create: if isValidId(chatUserId) &&
          isValidId(chatMsgId) &&
          isVerified() &&
          (isAdmin() || request.auth.uid == chatUserId) &&
          isValidChatMessage(incoming()) &&
          incoming().senderId == request.auth.uid &&
          (isAdmin() || incoming().senderRole == 'client') &&
          get(/databases/$(database)/documents/aizertech_chats/$(chatUserId)).data.userId == chatUserId &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(chatUserId) && isValidId(chatMsgId) && isAdmin();
      }
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll([
          'senderName',
          'senderEmail',
          'senderPhone',
          'serviceType',
          'budgetTier',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'senderName',
          'senderEmail',
          'senderPhone',
          'serviceType',
          'budgetTier',
          'message',
          'status',
          'adminNote',
          'createdAt',
          'updatedAt'
        ]) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 100 &&
        isValidEmail(data.senderEmail) &&
        data.senderPhone is string && data.senderPhone.size() <= 30 &&
        data.serviceType is string && data.serviceType.size() >= 2 && data.serviceType.size() <= 100 &&
        data.budgetTier is string && data.budgetTier.size() >= 1 && data.budgetTier.size() <= 60 &&
        data.message is string && data.message.size() >= 10 && data.message.size() <= 2000 &&
        isValidMessageStatus(data.status) &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 1500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /contactMessages/{messageId} {
      allow get: if isValidId(messageId) && (isAdmin() || (isVerified() && ('userId' in existing()) && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(messageId) &&
        isVerified() &&
        isValidContactMessage(incoming()) &&
        ('userId' in incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'new' &&
        !('adminNote' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(messageId) &&
        isAdmin() &&
        isValidContactMessage(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().senderName == existing().senderName &&
        incoming().senderEmail == existing().senderEmail &&
        incoming().senderPhone == existing().senderPhone &&
        incoming().serviceType == existing().serviceType &&
        incoming().budgetTier == existing().budgetTier &&
        incoming().message == existing().message &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if isValidId(messageId) && isAdmin();
    }

    function isValidAizerTechMessage(data) {
      return data.keys().hasAll([
          'name',
          'email',
          'phone',
          'service',
          'budget',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'name',
          'email',
          'phone',
          'service',
          'budget',
          'message',
          'status',
          'adminNote',
          'createdAt',
          'updatedAt'
        ]) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        isValidEmail(data.email) &&
        data.phone is string && data.phone.size() <= 30 &&
        data['service'] is string && data['service'].size() >= 2 && data['service'].size() <= 100 &&
        data.budget is string && data.budget.size() >= 1 && data.budget.size() <= 60 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
        isValidMessageStatus(data.status) &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 1500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /aizertech_messages/{messageId} {
      allow get: if isValidId(messageId) && (isAdmin() || (isVerified() && ('userId' in existing()) && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(messageId) &&
        isVerified() &&
        isValidAizerTechMessage(incoming()) &&
        ('userId' in incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'new' &&
        !('adminNote' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(messageId) &&
        isAdmin() &&
        isValidAizerTechMessage(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if isValidId(messageId) && isAdmin();
    }

    function isValidInvoice(data) {
      return data.keys().hasAll([
          'invoiceNumber',
          'clientName',
          'clientPhone',
          'clientEmail',
          'service',
          'amountGhs',
          'description',
          'invoiceDate',
          'status',
          'sourceMessageId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'invoiceNumber',
          'clientName',
          'clientPhone',
          'clientEmail',
          'service',
          'amountGhs',
          'description',
          'invoiceDate',
          'status',
          'sourceMessageId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.invoiceNumber is string && data.invoiceNumber.size() >= 2 && data.invoiceNumber.size() <= 30 &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
        data.clientPhone is string && data.clientPhone.size() <= 30 &&
        data.clientEmail is string && data.clientEmail.size() <= 150 &&
        data['service'] is string && data['service'].size() >= 2 && data['service'].size() <= 120 &&
        data.amountGhs is number && data.amountGhs >= 0 && data.amountGhs <= 10000000 &&
        data.description is string && data.description.size() >= 2 && data.description.size() <= 2000 &&
        data.invoiceDate is string && data.invoiceDate.size() >= 4 && data.invoiceDate.size() <= 30 &&
        data.status is string && data.status in ['unpaid', 'paid'] &&
        data.sourceMessageId is string && data.sourceMessageId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /aizertech_invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && (isAdmin() || (isVerified() && existing().clientEmail == request.auth.token.email));
      allow list: if isAdmin() || (isVerified() && resource.data.clientEmail == request.auth.token.email);
      allow create: if isValidId(invoiceId) &&
        isAdmin() &&
        isValidInvoice(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(invoiceId) &&
        isAdmin() &&
        isValidInvoice(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(invoiceId) && isAdmin();
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'clientName',
          'clientPhone',
          'preferredDate',
          'preferredTime',
          'service',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'clientName',
          'clientPhone',
          'preferredDate',
          'preferredTime',
          'service',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
        data.clientPhone is string && data.clientPhone.size() >= 7 && data.clientPhone.size() <= 30 &&
        data.preferredDate is string && data.preferredDate.size() >= 6 && data.preferredDate.size() <= 20 &&
        data.preferredTime is string && data.preferredTime.size() >= 3 && data.preferredTime.size() <= 30 &&
        data['service'] is string && data['service'].size() >= 2 && data['service'].size() <= 120 &&
        data.status is string && data.status in ['pending', 'confirmed', 'done', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /aizertech_bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (isAdmin() || (isVerified() && ('userId' in existing()) && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(bookingId) &&
        isVerified() &&
        isValidBooking(incoming()) &&
        ('userId' in incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(bookingId) &&
        isAdmin() &&
        isValidBooking(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll([
          'clientName',
          'service',
          'rating',
          'message',
          'photoUrl',
          'approved',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'clientName',
          'service',
          'rating',
          'message',
          'photoUrl',
          'approved',
          'createdAt',
          'updatedAt'
        ]) &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
        data['service'] is string && data['service'].size() >= 2 && data['service'].size() <= 120 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 1200 &&
        data.photoUrl is string && data.photoUrl.size() <= 500000 &&
        data.approved is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /aizertech_testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId) && (isAdmin() || existing().approved == true);
      allow list: if isAdmin() || resource.data.approved == true;
      allow create: if isValidId(testimonialId) &&
        isAdmin() &&
        isValidTestimonial(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(testimonialId) &&
        isAdmin() &&
        isValidTestimonial(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(testimonialId) && isAdmin();
    }

    function isValidStudioProject(data) {
      return data.keys().hasAll([
          'title',
          'clientName',
          'clientPhone',
          'serviceType',
          'amountGhs',
          'status',
          'notes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title',
          'clientName',
          'clientPhone',
          'serviceType',
          'amountGhs',
          'status',
          'notes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
        data.clientPhone is string && data.clientPhone.size() <= 30 &&
        data.serviceType is string && data.serviceType.size() >= 2 && data.serviceType.size() <= 80 &&
        data.amountGhs is number && data.amountGhs >= 0 && data.amountGhs <= 10000000 &&
        data.status is string && data.status in ['in_progress', 'done'] &&
        data.notes is string && data.notes.size() <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /studioProjects/{projectId} {
      allow get: if isValidId(projectId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(projectId) &&
        isAdmin() &&
        isValidStudioProject(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(projectId) &&
        isAdmin() &&
        isValidStudioProject(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(projectId) && isAdmin();
    }

    function isValidWebsiteCmsDoc(data) {
      return data.keys().hasAll([
          'hero',
          'services',
          'projects',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'hero',
          'services',
          'projects',
          'updatedAt',
          'publishedAt'
        ]) &&
        data.hero is map &&
        data.hero.keys().hasAll([
          'heroTitle',
          'heroSubtitle',
          'announcementBanner',
          'whatsappNumber',
          'email',
          'location',
          'aboutText',
          'whyUsPoints'
        ]) &&
        data.hero.heroTitle is string && data.hero.heroTitle.size() >= 4 && data.hero.heroTitle.size() <= 200 &&
        data.hero.heroSubtitle is string && data.hero.heroSubtitle.size() >= 4 && data.hero.heroSubtitle.size() <= 600 &&
        data.hero.announcementBanner is string && data.hero.announcementBanner.size() <= 200 &&
        data.hero.whatsappNumber is string && data.hero.whatsappNumber.size() >= 7 && data.hero.whatsappNumber.size() <= 25 &&
        isValidEmail(data.hero.email) &&
        data.hero.location is string && data.hero.location.size() >= 2 && data.hero.location.size() <= 100 &&
        data.hero.aboutText is string && data.hero.aboutText.size() >= 10 && data.hero.aboutText.size() <= 1200 &&
        data.hero.whyUsPoints is list && data.hero.whyUsPoints.size() <= 15 &&
        data.services is list && data.services.size() <= 30 &&
        data.projects is list && data.projects.size() <= 40 &&
        data.updatedAt is timestamp;
    }

    match /aizertech_live/{docId} {
      allow get: if isValidId(docId) && docId == 'website';
      allow list: if false;
      allow create, update: if isValidId(docId) &&
        docId == 'website' &&
        isAdmin() &&
        isValidWebsiteCmsDoc(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /aizertech_draft/{docId} {
      allow get: if isValidId(docId) && docId == 'website' && isAdmin();
      allow list: if false;
      allow create, update: if isValidId(docId) &&
        docId == 'website' &&
        isAdmin() &&
        isValidWebsiteCmsDoc(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /aizertech_backup/{backupId} {
      allow get: if isValidId(backupId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(backupId) &&
        isAdmin() &&
        incoming().keys().hasAll(['label', 'snapshot', 'backedUpAt']) &&
        incoming().keys().hasOnly(['label', 'snapshot', 'backedUpAt']) &&
        incoming().label is string && incoming().label.size() >= 2 && incoming().label.size() <= 120 &&
        incoming().snapshot is map &&
        incoming().backedUpAt == request.time;
      allow update: if false;
      allow delete: if isValidId(backupId) && isAdmin();
    }

    function isValidStudioSettings(data) {
      return data.keys().hasAll([
          'heroHeadline',
          'heroSubheadline',
          'announcementBanner',
          'websiteStartingPrice',
          'mobileStartingPrice',
          'brandingStartingPrice',
          'whatsappNumber',
          'contactEmail',
          'founderBio',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'heroHeadline',
          'heroSubheadline',
          'announcementBanner',
          'websiteStartingPrice',
          'mobileStartingPrice',
          'brandingStartingPrice',
          'whatsappNumber',
          'contactEmail',
          'founderBio',
          'momoNumber',
          'momoName',
          'autoReplyMessage',
          'workingHours',
          'updatedAt'
        ]) &&
        data.heroHeadline is string && data.heroHeadline.size() >= 10 && data.heroHeadline.size() <= 140 &&
        data.heroSubheadline is string && data.heroSubheadline.size() >= 10 && data.heroSubheadline.size() <= 350 &&
        data.announcementBanner is string && data.announcementBanner.size() <= 160 &&
        data.websiteStartingPrice is string && data.websiteStartingPrice.size() >= 2 && data.websiteStartingPrice.size() <= 40 &&
        data.mobileStartingPrice is string && data.mobileStartingPrice.size() >= 2 && data.mobileStartingPrice.size() <= 40 &&
        data.brandingStartingPrice is string && data.brandingStartingPrice.size() >= 2 && data.brandingStartingPrice.size() <= 40 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 7 && data.whatsappNumber.size() <= 20 &&
        isValidEmail(data.contactEmail) &&
        data.founderBio is string && data.founderBio.size() >= 20 && data.founderBio.size() <= 600 &&
        (!('momoNumber' in data) || (data.momoNumber is string && data.momoNumber.size() <= 30)) &&
        (!('momoName' in data) || (data.momoName is string && data.momoName.size() <= 80)) &&
        (!('autoReplyMessage' in data) || (data.autoReplyMessage is string && data.autoReplyMessage.size() <= 500)) &&
        (!('workingHours' in data) || (data.workingHours is string && data.workingHours.size() <= 120)) &&
        data.updatedAt is timestamp;
    }

    match /studioSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'public';
      allow list: if false;
      allow create, update: if isValidId(settingId) &&
        settingId == 'public' &&
        isAdmin() &&
        isValidStudioSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list, create, update, delete: if false;
    }
  }
}
