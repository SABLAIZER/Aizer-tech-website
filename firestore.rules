rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'sablahevans0@gmail.com';
    }

    function isValidEmail(email) {
      return email is string &&
        email.size() >= 5 &&
        email.size() <= 150 &&
        email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll([
          'senderName',
          'senderEmail',
          'senderPhone',
          'serviceType',
          'budgetTier',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'senderName',
          'senderEmail',
          'senderPhone',
          'serviceType',
          'budgetTier',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 100 &&
        isValidEmail(data.senderEmail) &&
        data.senderPhone is string && data.senderPhone.size() <= 30 &&
        data.serviceType is string && data.serviceType in [
          'Business Website (from GHS 800)',
          'Mobile App (from GHS 2,500)',
          'Food App / Custom Platform',
          'Consulting & UI/UX'
        ] &&
        data.budgetTier is string && data.budgetTier in [
          'GHS 800 - 1,500',
          'GHS 1,500 - 2,500',
          'GHS 2,500 - 5,000',
          'GHS 5,000+'
        ] &&
        data.message is string && data.message.size() >= 10 && data.message.size() <= 2000 &&
        data.status is string && data.status in ['new', 'reviewed', 'replied', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /contactMessages/{messageId} {
      allow get: if isValidId(messageId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(messageId) &&
        isValidContactMessage(incoming()) &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(messageId) &&
        isValidContactMessage(incoming()) &&
        isAdmin() &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().senderName == existing().senderName &&
        incoming().senderEmail == existing().senderEmail &&
        incoming().senderPhone == existing().senderPhone &&
        incoming().serviceType == existing().serviceType &&
        incoming().budgetTier == existing().budgetTier &&
        incoming().message == existing().message &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(messageId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list, create, update, delete: if false;
    }
  }
}
